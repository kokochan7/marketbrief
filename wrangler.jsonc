{
  // Cloudflare Worker that serves the Market Brief.
  // The page is rendered from content/brief.json; live quotes come from /api/live.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marketbrief",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true }
}
